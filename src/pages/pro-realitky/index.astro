---
import BaseLayout from '../../layouts/BaseLayout.astro';

const faqs = [
  {
    q: 'Jak funguje referral odměna?',
    a: 'Za doporučeného klienta nebo nemovitost, která se do programu úspěšně zapojí, získáte odměnu podle individuální partnerské smlouvy.',
  },
  {
    q: 'Musím nemovitost prodat přes vás, abych mohl klienta doporučit?',
    a: 'Ne. Stačí, že klient nebo nemovitost odpovídá kritériím programu pevného nájmu — samotný prodej může proběhnout kdekoli.',
  },
  {
    q: 'Co když klient nemovitost už vlastní?',
    a: 'I to je v pořádku — nemovitost posoudíme bez ohledu na to, kde a kdy byla koupena.',
  },
  {
    q: 'Kdy odměnu obdržím?',
    a: 'Až po podpisu smlouvy mezi vlastníkem a naší provozní společností, podle podmínek partnerské smlouvy.',
  },
  {
    q: 'Musíme podepsat dlouhodobou smlouvu, abychom mohli doporučovat klienty?',
    a: 'Ne, spolupráce může být příležitostná — partnerskou smlouvu podepisujeme kvůli jasným podmínkám odměny, ne kvůli závazku pravidelně doporučovat.',
  },
];
---
<BaseLayout
  title="Pro realitky — PhuketPropertyPartners"
  description="Nabídněte klientovi víc než jen nemovitost. Doporučte klienta nebo nemovitost do programu pevného nájmu a získejte referral odměnu."
  canonicalPath="/pro-realitky/"
  alternates={{ cs: '/pro-realitky/', en: '/en/for-agencies/', de: '/de/for-agencies/', ru: '/ru/for-agencies/' }}
  faqs={faqs}
>

<section class="hero">
  <div class="nav">
    <div class="brand">PhuketPropertyPartners</div>
    <div class="links">
      <a href="/">Domů</a>
      <a href="/pro-vlastniky/">Pro vlastníky</a>
      <a href="/pro-developery/">Pro developery</a>
      <a href="/pro-realitky/">Pro realitky</a>
      <a href="/en/for-agencies/" class="lang-switch">EN</a>
      <a href="/de/for-agencies/" class="lang-switch">DE</a>
      <a href="/ru/for-agencies/" class="lang-switch">RU</a>
    </div>
  </div>
  <div class="eyebrow">Pro realitní kanceláře</div>
  <h1 class="serif">Nabídněte klientovi<br>víc než jen nemovitost.</h1>
  <p>Doporučte vhodného klienta nebo nemovitost do našeho programu pevného nájmu. Vy se soustředíte na prodej, my na správu a pronájem.</p>
</section>

<section class="section" id="co-nabizime">
  <div class="head">
    <div class="eyebrow">Co nabízíme</div>
    <h2 class="serif">Řešení, které prodává</h2>
  </div>
  <ul class="list-plain">
    <li>Silnější prodejní argument — jasná odpověď na "co bude po koupi"</li>
    <li>Kompletní řešení po prodeji, bez nutnosti budovat vlastní property management tým</li>
    <li>Vhodné pro zahraniční investory hledající pevný příjem z pronájmu</li>
    <li>Lokální tým na Phuketu a dlouhodobé partnerství</li>
    <li>Referral odměna za doporučeného klienta nebo nemovitost</li>
  </ul>
</section>

<section class="section" id="referral">
  <div class="head">
    <div class="eyebrow">Referral program</div>
    <h2 class="serif">Hodnota i po dokončení prodeje</h2>
    <p>Realitní kanceláře a nezávislí makléři mohou získat odměnu za doporučení vhodného vlastníka nebo klienta do programu. Podmínky spolupráce a odměny stanovíme v samostatné partnerské smlouvě, individuálně podle situace.</p>
  </div>
</section>

<section class="section" id="faq">
  <div class="head">
    <div class="eyebrow">Časté otázky</div>
    <h2 class="serif">Co byste měli vědět</h2>
  </div>
  <div class="faq-list">
    {faqs.map(f => (
      <details class="faq-item">
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </div>
</section>

<footer id="kontakt">
  <div class="contact">
    <span><strong>Email:</strong> <a href="mailto:info@ownphuket.com">info@ownphuket.com</a></span>
    <span><strong>Thajsko:</strong> <a href="tel:+66640560006">+66 640 560 006</a></span>
    <span><strong>Evropa:</strong> <a href="tel:+420604253824">+420 604 253 824</a></span>
  </div>
  <div class="legal">
    <strong>PhuketPropertyPartners</strong> zprostředkovává správu a pronájem nemovitostí na Phuketu.
    Podmínky referral spolupráce, výše odměny i délka programu se vždy řídí individuální partnerskou smlouvou.
  </div>
</footer>

</BaseLayout>
