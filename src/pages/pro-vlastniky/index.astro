---
import BaseLayout from '../../layouts/BaseLayout.astro';

const faqs = [
  {
    q: 'Dostanu pevný nájem u každé nemovitosti?',
    a: 'Ne. Pevný nájem nabízíme jen u vhodných a schválených nemovitostí — každou nejdřív posoudíme podle lokality, ceny, stavu a pravidel projektu.',
  },
  {
    q: 'Z čeho se pevný nájem počítá?',
    a: 'Ze schválené hodnoty nemovitosti, přesně uvedené ve smlouvě. Tato hodnota nemusí zahrnovat daně, poplatky, sinking fund nebo náklady na financování — přesný základ potvrdíme před podpisem.',
  },
  {
    q: 'Zůstává nemovitost v mém vlastnictví?',
    a: 'Ano. Program je založen na nájemním a správním vztahu, vlastnictví se na nás nepřevádí.',
  },
  {
    q: 'Můžu nemovitost sám používat?',
    a: 'Záleží na zvoleném programu. U čistě investiční varianty je vlastní pobyt omezený, u kombinované varianty lze sjednat konkrétní počet dní pro vlastní užívání.',
  },
  {
    q: 'Co se stane, když nebudou hosté?',
    a: 'Nájem je stanovený smlouvou, ne výsledkem jednotlivých rezervací — provozní riziko neseme my.',
  },
  {
    q: 'Musím nemovitost koupit přes vás?',
    a: 'Ne. Posoudíme i nemovitost koupenou jinde nebo tu, kterou už vlastníte.',
  },
];
---
<BaseLayout
  title="Pro vlastníky — PhuketPropertyPartners"
  description="Pevný nájem za váš apartmán na Phuketu — ať už ho teprve vybíráte, nebo už ho vlastníte. Nemovitost zůstává vaše, o pronájem a správu se staráme my."
  canonicalPath="/pro-vlastniky/"
  alternates={{ cs: '/pro-vlastniky/', en: '/en/for-owners/', de: '/de/for-owners/', ru: '/ru/for-owners/' }}
  faqs={faqs}
>

<section class="hero">
  <div class="nav">
    <div class="brand">PhuketPropertyPartners</div>
    <div class="links">
      <a href="/">Domů</a>
      <a href="/pro-vlastniky/">Pro vlastníky</a>
      <a href="/pro-developery/">Pro developery</a>
      <a href="/pro-realitky/">Pro realitky</a>
      <a href="/en/for-owners/" class="lang-switch">EN</a>
      <a href="/de/for-owners/" class="lang-switch">DE</a>
      <a href="/ru/for-owners/" class="lang-switch">RU</a>
    </div>
  </div>
  <div class="eyebrow">Pro vlastníky</div>
  <h1 class="serif">Pevný nájem za váš<br>apartmán na Phuketu.</h1>
  <p>Ať už apartmán teprve vybíráte, nebo už na Phuketu nemovitost vlastníte — nabídneme vám pevně stanovený nájem bez ohledu na obsazenost.</p>
</section>

<section class="section" id="cesty">
  <div class="head">
    <div class="eyebrow">Dvě cesty</div>
    <h2 class="serif">Jak na tom jste?</h2>
  </div>
  <div class="own-compare">
    <div class="own-box">
      <div class="own-tag">Teprve vybíráte</div>
      <p>Vyberte konkrétní apartmán na OwnPhuket a od začátku víte, na jaký pevný nájem máte nárok — 7,5&#160;% p.a.</p>
      <a class="btn-send" href="https://ownphuket.com/#apartmany">Vybrat apartmán &rarr;</a>
    </div>
    <div class="own-box">
      <div class="own-tag">Už vlastníte, nebo jste koupili jinde</div>
      <p>Nemovitost posoudíme, a pokud vyhovuje, nabídneme stejný pevný nájem — bez ohledu na to, kde a jak jste ji koupili.</p>
      <a class="btn-send" href="mailto:info@ownphuket.com?subject=Posouzen%C3%AD%20nemovitosti">Nechat posoudit &rarr;</a>
    </div>
  </div>
</section>

<section class="process" id="jak-to-funguje">
  <div class="step">
    <div class="num">01</div>
    <h3 class="serif">Posoudíme</h3>
    <p>Lokalitu, kupní cenu, stav a vybavení, pravidla condominia i potenciál pronájmu.</p>
  </div>
  <div class="step">
    <div class="num">02</div>
    <h3 class="serif">Nabídneme</h3>
    <p>Výši pevného nájmu a délku smlouvy — standardně až na 5 let.</p>
  </div>
  <div class="step">
    <div class="num">03</div>
    <h3 class="serif">Podepíšeme smlouvu</h3>
    <p>Jasně dané podmínky — výše nájmu, platby, údržba, pojištění, ukončení.</p>
  </div>
  <div class="step">
    <div class="num">04</div>
    <h3 class="serif">Vyplácíme</h3>
    <p>Pravidelný pevný nájem. O marketing, hosty i provoz se staráme kompletně my.</p>
  </div>
</section>

<section class="section" id="co-nabizime">
  <div class="head">
    <div class="eyebrow">Co pro vás děláme</div>
    <h2 class="serif">Kompletní správa nemovitosti</h2>
  </div>
  <ul class="list-plain">
    <li>Předvídatelný příjem — předem víte, na jaký nájem máte podle smlouvy nárok</li>
    <li>Kompletní správa — o každodenní provoz, údržbu a kontroly se staráme my</li>
    <li>Žádná komunikace s hosty — rezervace, check-in i check-out řešíme za vás</li>
    <li>Lokální tým na Phuketu — nemovitost spravujeme přímo na místě</li>
    <li>Dlouhodobé řešení — schválené nemovitosti mohou získat smlouvu až na 5 let</li>
  </ul>
</section>

<section class="section" id="faq">
  <div class="head">
    <div class="eyebrow">Časté otázky</div>
    <h2 class="serif">Co byste měli vědět</h2>
  </div>
  <div class="faq-list">
    {faqs.map(f => (
      <details class="faq-item">
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </div>
</section>

<footer id="kontakt">
  <div class="contact">
    <span><strong>Email:</strong> <a href="mailto:info@ownphuket.com">info@ownphuket.com</a></span>
    <span><strong>Thajsko:</strong> <a href="tel:+66640560006">+66 640 560 006</a></span>
    <span><strong>Evropa:</strong> <a href="tel:+420604253824">+420 604 253 824</a></span>
  </div>
  <div class="legal">
    <strong>PhuketPropertyPartners</strong> zprostředkovává správu a pronájem nemovitostí na Phuketu.
    Nejde o investiční fond, alternativní fond ani podílovou investici — každá nemovitost zůstává ve vlastnictví
    konkrétního klienta a nájem plyne z jejího pronájmu, nikoli z vkladu kapitálu do společnosti.
  </div>
</footer>

</BaseLayout>
