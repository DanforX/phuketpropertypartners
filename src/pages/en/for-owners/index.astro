---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const faqs = [
  {
    q: 'Will I get a fixed rent for every property?',
    a: 'No. We offer a fixed rent only for suitable, approved properties — each one is first assessed by location, price, condition and the project\u2019s rules.',
  },
  {
    q: 'What is the fixed rent calculated from?',
    a: 'From the approved property value, stated exactly in the contract. This value may exclude taxes, fees, sinking fund, or financing costs — the exact base is confirmed before signing.',
  },
  {
    q: 'Do I keep ownership of the property?',
    a: 'Yes. The program is based on a rental and management relationship — ownership is never transferred to us.',
  },
  {
    q: 'Can I use the property myself?',
    a: 'It depends on the program you choose. A purely investment variant limits personal stays; a combined variant lets you agree on a specific number of days for personal use.',
  },
  {
    q: 'What happens if there are no guests?',
    a: 'The rent is set by contract, not by the outcome of individual bookings — we carry the operational risk.',
  },
  {
    q: 'Do I have to buy the property through you?',
    a: 'No. We also assess properties bought elsewhere or already owned.',
  },
];
---
<BaseLayout
  lang="en"
  title="For Owners — PhuketPropertyPartners"
  description="Fixed rent for your apartment in Phuket — whether you're still choosing one or already own it. The property stays yours, we handle the rental and management."
  canonicalPath="/en/for-owners/"
>

<section class="hero">
  <div class="nav">
    <div class="brand">PhuketPropertyPartners</div>
    <div class="links">
      <a href="/en/">Home</a>
      <a href="/en/for-owners/">For Owners</a>
      <a href="/en/for-developers/">For Developers</a>
      <a href="/en/for-agencies/">For Agencies</a>
      <a href="/pro-vlastniky/" class="lang-switch">CZ</a>
      <a href="/de/for-owners/" class="lang-switch">DE</a>
      <a href="/ru/for-owners/" class="lang-switch">RU</a>
    </div>
  </div>
  <div class="eyebrow">For Owners</div>
  <h1 class="serif">Fixed rent for your<br>apartment in Phuket.</h1>
  <p>Whether you're still choosing an apartment or already own one in Phuket — we offer a fixed rent, regardless of occupancy.</p>
</section>

<section class="section" id="paths">
  <div class="head">
    <div class="eyebrow">Two paths</div>
    <h2 class="serif">Where are you at?</h2>
  </div>
  <div class="own-compare">
    <div class="own-box">
      <div class="own-tag">Still choosing</div>
      <p>Choose a specific apartment on OwnPhuket and know from the start what fixed rent you're entitled to — 7.5% p.a.</p>
      <a class="btn-send" href="https://ownphuket.com/en/#apartments">Choose an apartment &rarr;</a>
    </div>
    <div class="own-box">
      <div class="own-tag">Already own one, or bought elsewhere</div>
      <p>We'll assess the property, and if it qualifies, offer the same fixed rent — regardless of where or how you bought it.</p>
      <a class="btn-send" href="mailto:info@ownphuket.com?subject=Property%20Assessment">Get it assessed &rarr;</a>
    </div>
  </div>
</section>

<section class="process" id="how-it-works">
  <div class="step">
    <div class="num">01</div>
    <h3 class="serif">We assess</h3>
    <p>Location, purchase price, condition and fittings, condominium rules, and rental potential.</p>
  </div>
  <div class="step">
    <div class="num">02</div>
    <h3 class="serif">We offer</h3>
    <p>The fixed rent amount and contract length — standard terms up to 5 years.</p>
  </div>
  <div class="step">
    <div class="num">03</div>
    <h3 class="serif">We sign a contract</h3>
    <p>Clearly stated terms — rent amount, payments, maintenance, insurance, termination.</p>
  </div>
  <div class="step">
    <div class="num">04</div>
    <h3 class="serif">We pay out</h3>
    <p>Regular fixed rent. We handle marketing, guests and operations end to end.</p>
  </div>
</section>

<section class="section" id="what-we-offer">
  <div class="head">
    <div class="eyebrow">What we do for you</div>
    <h2 class="serif">Complete property management</h2>
  </div>
  <ul class="list-plain">
    <li>Predictable income — you know from the contract exactly what rent you're entitled to</li>
    <li>Complete management — we handle day-to-day operations, maintenance and inspections</li>
    <li>No guest communication — we handle bookings, check-in and check-out for you</li>
    <li>Local team in Phuket — we manage the property directly on site</li>
    <li>Long-term solution — approved properties can get a contract for up to 5 years</li>
  </ul>
</section>

<section class="section" id="faq">
  <div class="head">
    <div class="eyebrow">FAQ</div>
    <h2 class="serif">What you should know</h2>
  </div>
  <div class="faq-list">
    {faqs.map(f => (
      <details class="faq-item">
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </div>
</section>

<footer id="contact">
  <div class="contact">
    <span><strong>Email:</strong> <a href="mailto:info@ownphuket.com">info@ownphuket.com</a></span>
    <span><strong>Thailand:</strong> <a href="tel:+66640560006">+66 640 560 006</a></span>
    <span><strong>Europe:</strong> <a href="tel:+420604253824">+420 604 253 824</a></span>
  </div>
  <div class="legal">
    <strong>PhuketPropertyPartners</strong> arranges the management and rental of properties in Phuket.
    This is not an investment fund, alternative fund, or collective investment scheme — each property remains
    owned by the individual client, and the rent comes from its rental, not from a capital contribution to a company.
  </div>
</footer>

</BaseLayout>
