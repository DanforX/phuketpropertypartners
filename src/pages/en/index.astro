---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  lang="en"
  canonicalPath="/en/"
  title="PhuketPropertyPartners — Fixed Rent for Owners, Developers and Agencies"
  description="Fixed rent for your property in Phuket — for owners, developers and real estate agencies. You own the property, we handle the rental and management."
>

<section class="hero">
  <div class="nav">
    <div class="brand">PhuketPropertyPartners</div>
    <div class="links">
      <a href="/en/for-owners/">For Owners</a>
      <a href="/en/for-developers/">For Developers</a>
      <a href="/en/for-agencies/">For Agencies</a>
      <a href="/" class="lang-switch">CZ</a>
      <a href="/de/" class="lang-switch">DE</a>
      <a href="/ru/" class="lang-switch">RU</a>
    </div>
  </div>
  <div class="eyebrow">Property Management &amp; Rental &middot; Phuket</div>
  <h1 class="serif">Fixed rent for your<br>property in Phuket.</h1>
  <p>You own the property. We handle the rental, guests, and operations — for a fixed rent, regardless of occupancy.</p>
  <div class="cta-row">
    <a class="btn btn-primary" href="/en/for-owners/">I'm an owner</a>
    <a class="btn btn-ghost" href="#who-for">I'm a developer or agency &rarr;</a>
  </div>
</section>

<section class="section" id="who-for">
  <div class="head">
    <div class="eyebrow">Who this is for</div>
    <h2 class="serif">Choose what fits your situation.</h2>
    <p>Whether you own a property, sell them, or refer clients — we have a concrete solution for you.</p>
  </div>
  <div class="paths">
    <div class="path-card">
      <div class="path-num">01</div>
      <h3 class="serif">You own a property</h3>
      <p>Whether you're still choosing an apartment or already own one in Phuket — we offer a fixed rent and complete management.</p>
      <a class="btn-send" href="/en/for-owners/">For Owners &rarr;</a>
    </div>
    <div class="path-card">
      <div class="path-num">02</div>
      <h3 class="serif">You're a developer</h3>
      <p>Give clients a clear answer to "what happens after purchase" — without building your own rental team.</p>
      <a class="btn-send" href="/en/for-developers/">For Developers &rarr;</a>
    </div>
    <div class="path-card">
      <div class="path-num">03</div>
      <h3 class="serif">You're a real estate agency</h3>
      <p>Refer a client or property into the program and offer a solution for the period after the sale too.</p>
      <a class="btn-send" href="/en/for-agencies/">For Agencies &rarr;</a>
    </div>
  </div>
</section>

<footer id="contact">
  <div class="contact">
    <span><strong>Email:</strong> <a href="mailto:info@ownphuket.com">info@ownphuket.com</a></span>
    <span><strong>Thailand:</strong> <a href="tel:+66640560006">+66 640 560 006</a></span>
    <span><strong>Europe:</strong> <a href="tel:+420604253824">+420 604 253 824</a></span>
  </div>
  <div class="legal">
    <strong>PhuketPropertyPartners</strong> arranges the management and rental of properties in Phuket.
    This is not an investment fund, alternative fund, or collective investment scheme — each property remains
    owned by the individual client, and the rent comes from its rental, not from a capital contribution to a company.
  </div>
</footer>

</BaseLayout>
