---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout
  lang="en"
  title="For Agencies — PhuketPropertyPartners"
  description="Offer your client more than just a property. Refer a client or property into the fixed rent program and earn a referral reward."
  canonicalPath="/en/for-agencies/"
  alternates={{ cs: '/pro-realitky/', en: '/en/for-agencies/', de: '/de/for-agencies/', ru: '/ru/for-agencies/' }}
>

<section class="hero">
  <div class="nav">
    <div class="brand">PhuketPropertyPartners</div>
    <div class="links">
      <a href="/en/">Home</a>
      <a href="/en/for-owners/">For Owners</a>
      <a href="/en/for-developers/">For Developers</a>
      <a href="/en/for-agencies/">For Agencies</a>
      <a href="/pro-realitky/" class="lang-switch">CZ</a>
      <a href="/de/for-agencies/" class="lang-switch">DE</a>
      <a href="/ru/for-agencies/" class="lang-switch">RU</a>
    </div>
  </div>
  <div class="eyebrow">For Real Estate Agencies</div>
  <h1 class="serif">Offer your client more<br>than just a property.</h1>
  <p>Refer a suitable client or property into our fixed rent program. You focus on the sale, we focus on management and rental.</p>
</section>

<section class="section" id="what-we-offer">
  <div class="head">
    <div class="eyebrow">What we offer</div>
    <h2 class="serif">A solution that sells</h2>
  </div>
  <ul class="list-plain">
    <li>A stronger sales argument — a clear answer to "what happens after purchase"</li>
    <li>Complete post-sale solution, no need to build your own property management team</li>
    <li>A fit for foreign investors looking for fixed rental income</li>
    <li>Local team in Phuket and a long-term partnership</li>
    <li>Referral reward for a referred client or property</li>
  </ul>
</section>

<section class="section" id="referral">
  <div class="head">
    <div class="eyebrow">Referral program</div>
    <h2 class="serif">Value even after the sale closes</h2>
    <p>Real estate agencies and independent agents can earn a reward for referring a suitable owner or client into the program. Cooperation terms and rewards are set out in a separate partnership agreement, individually per situation.</p>
  </div>
</section>

<footer id="contact">
  <div class="contact">
    <span><strong>Email:</strong> <a href="mailto:info@ownphuket.com">info@ownphuket.com</a></span>
    <span><strong>Thailand:</strong> <a href="tel:+66640560006">+66 640 560 006</a></span>
    <span><strong>Europe:</strong> <a href="tel:+420604253824">+420 604 253 824</a></span>
  </div>
  <div class="legal">
    <strong>PhuketPropertyPartners</strong> arranges the management and rental of properties in Phuket.
    Referral cooperation terms, reward amounts, and program length are always governed by an individual
    partnership agreement.
  </div>
</footer>

</BaseLayout>
