---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const faqs = [
  {
    q: 'Получу ли я фиксированную аренду для любой недвижимости?',
    a: 'Нет. Мы предлагаем фиксированную аренду только для подходящих, одобренных объектов — каждый сначала оценивается по локации, цене, состоянию и правилам проекта.',
  },
  {
    q: 'Из чего рассчитывается фиксированная аренда?',
    a: 'Из одобренной стоимости объекта, точно указанной в договоре. Эта стоимость может не включать налоги, сборы, ремонтный фонд или расходы на финансирование — точная база подтверждается перед подписанием.',
  },
  {
    q: 'Остаётся ли недвижимость в моей собственности?',
    a: 'Да. Программа основана на арендных и управленческих отношениях — право собственности к нам не переходит.',
  },
  {
    q: 'Могу ли я сам пользоваться недвижимостью?',
    a: 'Зависит от выбранной программы. При чисто инвестиционном варианте личное проживание ограничено, при комбинированном варианте можно согласовать конкретное количество дней для личного использования.',
  },
  {
    q: 'Что будет, если не будет гостей?',
    a: 'Аренда установлена договором, а не результатом отдельных бронирований — операционный риск несём мы.',
  },
  {
    q: 'Должен ли я покупать недвижимость через вас?',
    a: 'Нет. Мы оцениваем и объекты, купленные в другом месте или уже находящиеся в вашей собственности.',
  },
];
---
<BaseLayout
  lang="ru"
  title="Владельцам — PhuketPropertyPartners"
  description="Фиксированная аренда за ваши апартаменты на Пхукете — выбираете ли вы их сейчас или уже владеете. Недвижимость остаётся вашей, мы занимаемся арендой и управлением."
  canonicalPath="/ru/for-owners/"
>

<section class="hero">
  <div class="nav">
    <div class="brand">PhuketPropertyPartners</div>
    <div class="links">
      <a href="/ru/">Главная</a>
      <a href="/ru/for-owners/">Владельцам</a>
      <a href="/ru/for-developers/">Застройщикам</a>
      <a href="/ru/for-agencies/">Агентствам</a>
      <a href="/pro-vlastniky/" class="lang-switch">CZ</a>
      <a href="/en/for-owners/" class="lang-switch">EN</a>
      <a href="/de/for-owners/" class="lang-switch">DE</a>
    </div>
  </div>
  <div class="eyebrow">Владельцам</div>
  <h1 class="serif">Фиксированная аренда за ваши<br>апартаменты на Пхукете.</h1>
  <p>Ещё выбираете апартаменты или уже владеете недвижимостью на Пхукете — мы предлагаем фиксированную аренду независимо от заполняемости.</p>
</section>

<section class="section" id="puti">
  <div class="head">
    <div class="eyebrow">Два пути</div>
    <h2 class="serif">На каком вы этапе?</h2>
  </div>
  <div class="own-compare">
    <div class="own-box">
      <div class="own-tag">Ещё выбираете</div>
      <p>Выберите конкретные апартаменты на OwnPhuket и с самого начала знайте, на какую фиксированную аренду вы имеете право — 7,5% годовых.</p>
      <a class="btn-send" href="https://ownphuket.com/ru/#apartments">Выбрать апартаменты &rarr;</a>
    </div>
    <div class="own-box">
      <div class="own-tag">Уже владеете, или купили в другом месте</div>
      <p>Мы оценим объект, и если он подходит, предложим ту же фиксированную аренду — независимо от того, где и как вы его купили.</p>
      <a class="btn-send" href="mailto:info@ownphuket.com?subject=%D0%9E%D1%86%D0%B5%D0%BD%D0%BA%D0%B0%20%D0%BE%D0%B1%D1%8A%D0%B5%D0%BA%D1%82%D0%B0">Оценить объект &rarr;</a>
    </div>
  </div>
</section>

<section class="process" id="kak-eto-rabotaet">
  <div class="step">
    <div class="num">01</div>
    <h3 class="serif">Оцениваем</h3>
    <p>Локацию, цену покупки, состояние и оснащение, правила кондоминиума и потенциал аренды.</p>
  </div>
  <div class="step">
    <div class="num">02</div>
    <h3 class="serif">Предлагаем</h3>
    <p>Размер фиксированной аренды и срок договора — стандартно до 5 лет.</p>
  </div>
  <div class="step">
    <div class="num">03</div>
    <h3 class="serif">Подписываем договор</h3>
    <p>Чётко определённые условия — размер аренды, платежи, обслуживание, страхование, расторжение.</p>
  </div>
  <div class="step">
    <div class="num">04</div>
    <h3 class="serif">Выплачиваем</h3>
    <p>Регулярную фиксированную аренду. Маркетингом, гостями и эксплуатацией занимаемся полностью мы.</p>
  </div>
</section>

<section class="section" id="chto-my-delaem">
  <div class="head">
    <div class="eyebrow">Что мы делаем для вас</div>
    <h2 class="serif">Полное управление недвижимостью</h2>
  </div>
  <ul class="list-plain">
    <li>Предсказуемый доход — вы заранее знаете, на какую аренду имеете право по договору</li>
    <li>Полное управление — повседневной эксплуатацией, обслуживанием и проверками занимаемся мы</li>
    <li>Никакого общения с гостями — бронирования, заезд и выезд решаем за вас</li>
    <li>Локальная команда на Пхукете — управляем недвижимостью прямо на месте</li>
    <li>Долгосрочное решение — одобренные объекты могут получить договор на срок до 5 лет</li>
  </ul>
</section>

<section class="section" id="faq">
  <div class="head">
    <div class="eyebrow">Частые вопросы</div>
    <h2 class="serif">Что вам стоит знать</h2>
  </div>
  <div class="faq-list">
    {faqs.map(f => (
      <details class="faq-item">
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </div>
</section>

<footer id="contact">
  <div class="contact">
    <span><strong>Email:</strong> <a href="mailto:info@ownphuket.com">info@ownphuket.com</a></span>
    <span><strong>Таиланд:</strong> <a href="tel:+66640560006">+66 640 560 006</a></span>
    <span><strong>Европа:</strong> <a href="tel:+420604253824">+420 604 253 824</a></span>
  </div>
  <div class="legal">
    <strong>PhuketPropertyPartners</strong> организует управление и аренду недвижимости на Пхукете.
    Это не инвестиционный фонд, альтернативный фонд или схема коллективных инвестиций — каждый объект остаётся
    в собственности отдельного клиента, а доход формируется от его аренды, а не от взноса капитала в компанию.
  </div>
</footer>

</BaseLayout>
