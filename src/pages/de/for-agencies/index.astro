---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const faqs = [
  {
    q: 'Wie funktioniert die Vermittlungsprämie?',
    a: 'Sie erhalten gemäß individueller Partnerschaftsvereinbarung eine Prämie für einen vermittelten Kunden oder eine Immobilie, die erfolgreich ins Programm aufgenommen wird.',
  },
  {
    q: 'Muss ich die Immobilie über Sie verkaufen, um einen Kunden zu vermitteln?',
    a: 'Nein. Der Kunde oder die Immobilie muss nur die Kriterien des Festmietprogramms erfüllen — der Verkauf selbst kann überall stattfinden.',
  },
  {
    q: 'Was, wenn der Kunde die Immobilie bereits besitzt?',
    a: 'Auch das ist möglich — wir prüfen die Immobilie unabhängig davon, wo und wann sie gekauft wurde.',
  },
  {
    q: 'Wann erhalte ich die Prämie?',
    a: 'Nach Unterzeichnung des Vertrags zwischen Eigentümer und unserer Betriebsgesellschaft, gemäß den Bedingungen der Partnerschaftsvereinbarung.',
  },
  {
    q: 'Brauchen wir einen langfristigen Vertrag, um Kunden zu vermitteln?',
    a: 'Nein, die Zusammenarbeit kann gelegentlich sein — wir schließen eine Partnerschaftsvereinbarung für klare Prämienbedingungen ab, nicht um Sie zu regelmäßigen Empfehlungen zu verpflichten.',
  },
];
---
<BaseLayout
  lang="de"
  title="Für Makler — PhuketPropertyPartners"
  description="Bieten Sie Ihrem Kunden mehr als nur eine Immobilie. Vermitteln Sie einen Kunden oder eine Immobilie in das Programm mit fester Miete und erhalten Sie eine Vermittlungsprämie."
  canonicalPath="/de/for-agencies/"
  alternates={{ cs: '/pro-realitky/', en: '/en/for-agencies/', de: '/de/for-agencies/', ru: '/ru/for-agencies/' }}
  faqs={faqs}
>

<section class="hero">
  <div class="nav">
    <div class="brand">PhuketPropertyPartners</div>
    <div class="links">
      <a href="/de/">Startseite</a>
      <a href="/de/for-owners/">Für Eigentümer</a>
      <a href="/de/for-developers/">Für Bauträger</a>
      <a href="/de/for-agencies/">Für Makler</a>
      <a href="/pro-realitky/" class="lang-switch">CZ</a>
      <a href="/en/for-agencies/" class="lang-switch">EN</a>
      <a href="/ru/for-agencies/" class="lang-switch">RU</a>
    </div>
  </div>
  <div class="eyebrow">Für Immobilienmakler</div>
  <h1 class="serif">Bieten Sie Ihrem Kunden<br>mehr als nur eine Immobilie.</h1>
  <p>Vermitteln Sie einen passenden Kunden oder eine Immobilie in unser Programm mit fester Miete. Sie konzentrieren sich auf den Verkauf, wir auf Verwaltung und Vermietung.</p>
</section>

<section class="section" id="was-wir-bieten">
  <div class="head">
    <div class="eyebrow">Was wir bieten</div>
    <h2 class="serif">Eine Lösung, die verkauft</h2>
  </div>
  <ul class="list-plain">
    <li>Ein stärkeres Verkaufsargument — eine klare Antwort auf "was passiert nach dem Kauf"</li>
    <li>Komplette Lösung nach dem Verkauf, ohne eigenes Property-Management-Team aufzubauen</li>
    <li>Passend für ausländische Investoren, die eine feste Mieteinnahme suchen</li>
    <li>Lokales Team auf Phuket und langfristige Partnerschaft</li>
    <li>Vermittlungsprämie für einen vermittelten Kunden oder eine Immobilie</li>
  </ul>
</section>

<section class="section" id="referral">
  <div class="head">
    <div class="eyebrow">Vermittlungsprogramm</div>
    <h2 class="serif">Wert auch nach Abschluss des Verkaufs</h2>
    <p>Immobilienmakler und unabhängige Vermittler können eine Prämie für die Vermittlung eines geeigneten Eigentümers oder Kunden in das Programm erhalten. Die Bedingungen der Zusammenarbeit und die Höhe der Prämie werden individuell in einem separaten Partnerschaftsvertrag festgelegt.</p>
  </div>
</section>

<section class="section" id="faq">
  <div class="head">
    <div class="eyebrow">FAQ</div>
    <h2 class="serif">Was Sie wissen sollten</h2>
  </div>
  <div class="faq-list">
    {faqs.map(f => (
      <details class="faq-item">
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </div>
</section>

<footer id="contact">
  <div class="contact">
    <span><strong>Email:</strong> <a href="mailto:info@ownphuket.com">info@ownphuket.com</a></span>
    <span><strong>Thailand:</strong> <a href="tel:+66640560006">+66 640 560 006</a></span>
    <span><strong>Europa:</strong> <a href="tel:+420604253824">+420 604 253 824</a></span>
  </div>
  <div class="legal">
    <strong>PhuketPropertyPartners</strong> organisiert die Verwaltung und Vermietung von Immobilien auf Phuket.
    Die Bedingungen der Vermittlung, die Höhe der Prämie und die Programmlaufzeit richten sich stets nach
    einem individuellen Partnerschaftsvertrag.
  </div>
</footer>

</BaseLayout>
