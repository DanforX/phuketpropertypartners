---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const faqs = [
  {
    q: 'Bekomme ich bei jeder Immobilie eine feste Miete?',
    a: 'Nein. Wir bieten eine feste Miete nur für geeignete, genehmigte Immobilien — jede wird zunächst nach Lage, Preis, Zustand und den Projektregeln geprüft.',
  },
  {
    q: 'Woraus wird die feste Miete berechnet?',
    a: 'Aus dem genehmigten Immobilienwert, der genau im Vertrag angegeben ist. Dieser Wert schließt möglicherweise Steuern, Gebühren, Instandhaltungsrücklage oder Finanzierungskosten nicht ein — die genaue Berechnungsgrundlage wird vor Vertragsunterzeichnung bestätigt.',
  },
  {
    q: 'Bleibt die Immobilie in meinem Eigentum?',
    a: 'Ja. Das Programm basiert auf einem Miet- und Verwaltungsverhältnis — das Eigentum wird nicht auf uns übertragen.',
  },
  {
    q: 'Kann ich die Immobilie selbst nutzen?',
    a: 'Das hängt vom gewählten Programm ab. Bei einer reinen Investitionsvariante ist der persönliche Aufenthalt eingeschränkt, bei einer kombinierten Variante kann eine bestimmte Anzahl an Tagen zur persönlichen Nutzung vereinbart werden.',
  },
  {
    q: 'Was passiert, wenn es keine Gäste gibt?',
    a: 'Die Miete wird vertraglich festgelegt, nicht durch das Ergebnis einzelner Buchungen — das Betriebsrisiko tragen wir.',
  },
  {
    q: 'Muss ich die Immobilie bei Ihnen kaufen?',
    a: 'Nein. Wir prüfen auch anderswo gekaufte oder bereits im Besitz befindliche Immobilien.',
  },
];
---
<BaseLayout
  lang="de"
  title="Für Eigentümer — PhuketPropertyPartners"
  description="Feste Miete für Ihre Wohnung auf Phuket — ob Sie noch auswählen oder bereits besitzen. Die Immobilie bleibt Ihre, wir kümmern uns um Vermietung und Verwaltung."
  canonicalPath="/de/for-owners/"
>

<section class="hero">
  <div class="nav">
    <div class="brand">PhuketPropertyPartners</div>
    <div class="links">
      <a href="/de/">Startseite</a>
      <a href="/de/for-owners/">Für Eigentümer</a>
      <a href="/de/for-developers/">Für Bauträger</a>
      <a href="/de/for-agencies/">Für Makler</a>
      <a href="/pro-vlastniky/" class="lang-switch">CZ</a>
      <a href="/en/for-owners/" class="lang-switch">EN</a>
      <a href="/ru/for-owners/" class="lang-switch">RU</a>
    </div>
  </div>
  <div class="eyebrow">Für Eigentümer</div>
  <h1 class="serif">Feste Miete für Ihre<br>Wohnung auf Phuket.</h1>
  <p>Ob Sie noch eine Wohnung auswählen oder bereits eine auf Phuket besitzen — wir bieten eine feste Miete, unabhängig von der Auslastung.</p>
</section>

<section class="section" id="wege">
  <div class="head">
    <div class="eyebrow">Zwei Wege</div>
    <h2 class="serif">Wo stehen Sie gerade?</h2>
  </div>
  <div class="own-compare">
    <div class="own-box">
      <div class="own-tag">Noch in der Auswahl</div>
      <p>Wählen Sie eine konkrete Wohnung bei OwnPhuket und wissen Sie von Anfang an, auf welche feste Miete Sie Anspruch haben — 7,5&#160;% p.a.</p>
      <a class="btn-send" href="https://ownphuket.com/de/#apartments">Wohnung wählen &rarr;</a>
    </div>
    <div class="own-box">
      <div class="own-tag">Besitzen bereits, oder haben anderswo gekauft</div>
      <p>Wir prüfen die Immobilie, und wenn sie geeignet ist, bieten wir dieselbe feste Miete — unabhängig davon, wo und wie Sie gekauft haben.</p>
      <a class="btn-send" href="mailto:info@ownphuket.com?subject=Immobilienbewertung">Bewerten lassen &rarr;</a>
    </div>
  </div>
</section>

<section class="process" id="ablauf">
  <div class="step">
    <div class="num">01</div>
    <h3 class="serif">Wir prüfen</h3>
    <p>Lage, Kaufpreis, Zustand und Ausstattung, Kondominium-Regeln sowie das Vermietungspotenzial.</p>
  </div>
  <div class="step">
    <div class="num">02</div>
    <h3 class="serif">Wir bieten an</h3>
    <p>Die Höhe der festen Miete und die Vertragslaufzeit — standardmäßig bis zu 5 Jahre.</p>
  </div>
  <div class="step">
    <div class="num">03</div>
    <h3 class="serif">Wir unterzeichnen</h3>
    <p>Klar festgelegte Bedingungen — Mietbetrag, Zahlungen, Instandhaltung, Versicherung, Kündigung.</p>
  </div>
  <div class="step">
    <div class="num">04</div>
    <h3 class="serif">Wir zahlen aus</h3>
    <p>Regelmäßige feste Miete. Um Marketing, Gäste und Betrieb kümmern wir uns vollständig.</p>
  </div>
</section>

<section class="section" id="was-wir-bieten">
  <div class="head">
    <div class="eyebrow">Was wir für Sie übernehmen</div>
    <h2 class="serif">Komplette Objektverwaltung</h2>
  </div>
  <ul class="list-plain">
    <li>Vorhersehbares Einkommen — Sie wissen vertraglich genau, welche Miete Ihnen zusteht</li>
    <li>Komplette Verwaltung — wir kümmern uns um laufenden Betrieb, Instandhaltung und Kontrollen</li>
    <li>Keine Gästekommunikation — wir übernehmen Buchungen, Check-in und Check-out für Sie</li>
    <li>Lokales Team auf Phuket — wir verwalten die Immobilie direkt vor Ort</li>
    <li>Langfristige Lösung — genehmigte Immobilien können einen Vertrag bis zu 5 Jahren erhalten</li>
  </ul>
</section>

<section class="section" id="faq">
  <div class="head">
    <div class="eyebrow">FAQ</div>
    <h2 class="serif">Was Sie wissen sollten</h2>
  </div>
  <div class="faq-list">
    {faqs.map(f => (
      <details class="faq-item">
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </div>
</section>

<footer id="contact">
  <div class="contact">
    <span><strong>Email:</strong> <a href="mailto:info@ownphuket.com">info@ownphuket.com</a></span>
    <span><strong>Thailand:</strong> <a href="tel:+66640560006">+66 640 560 006</a></span>
    <span><strong>Europa:</strong> <a href="tel:+420604253824">+420 604 253 824</a></span>
  </div>
  <div class="legal">
    <strong>PhuketPropertyPartners</strong> organisiert die Verwaltung und Vermietung von Immobilien auf Phuket.
    Dies ist kein Investmentfonds, alternativer Fonds oder Vehikel für gemeinschaftliche Kapitalanlagen — jede Immobilie bleibt
    im Eigentum des einzelnen Kunden, und die Miete stammt aus deren Vermietung, nicht aus einer Kapitaleinlage in ein Unternehmen.
  </div>
</footer>

</BaseLayout>
